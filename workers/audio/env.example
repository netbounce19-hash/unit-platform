# ONLY fresh disposable local Supabase. No NEXT_PUBLIC variables, no hosted key.
UNIT_AUDIO_DISPOSABLE=yes
UNIT_TEST_SUPABASE_URL=http://127.0.0.1:55421
UNIT_TEST_SUPABASE_SERVICE_ROLE_KEY=
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# Entry requires qualified FFmpeg/FFprobe 9.1; provision externally, pin build.
MAX_SOURCE_SIZE_MB=250
MAX_AUDIO_DURATION_MIN=30
MAX_CONCURRENT_JOBS=1
MAX_JOB_ATTEMPTS=3
MAX_JOB_SECONDS=300
MAX_OUTPUT_SIZE_MB=45
MAX_TEMP_SIZE_MB=310
WORKER_IDLE_TIMEOUT=60
WORKER_MAX_RUNTIME=600
FFMPEG_THREADS=1
AUDIO_TEMP_ROOT=/tmp
