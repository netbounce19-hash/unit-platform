# Disposable/local only. Do not set these on Vercel or production hosts.
UNIT_AUDIO_GATEWAY_DISPOSABLE=yes
UNIT_AUDIO_DISPOSABLE=yes
UNIT_TEST_SUPABASE_URL=http://127.0.0.1:55421
UNIT_TEST_SUPABASE_SERVICE_ROLE_KEY=
# Canonical test origin; existing NEXT_PUBLIC_SITE_URL is used if no override.
# HTTPS is required for actual browser Secure-cookie qualification.
UNIT_AUDIO_GATEWAY_ORIGIN=https://localhost:3000
# Separate random 32-byte base64url keys; generate locally, do not commit values.
UNIT_AUDIO_RATE_HMAC_KEY=
UNIT_AUDIO_PROXY_HMAC_KEY=
