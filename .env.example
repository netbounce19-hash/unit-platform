# Supabase (self-hosted) — публичные значения, попадают в браузерный бандл.
# Скопируйте в .env.local и заполните значениями своего инстанса.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ВНИМАНИЕ: service_role ключ здесь не место — он даёт полный доступ в обход RLS.
# Никогда не префиксуйте его NEXT_PUBLIC_ и не используйте в клиентском коде.
# Для миграций/серверных задач держите его в окружении CI или локальном шелле.

# ВРЕМЕННО, только для локальной разработки кабинета лейбла (components/label/LabelGate.tsx):
# если задать оба значения, гейт /label/* сам логинится этим аккаунтом и
# пропускает экран входа — удобно, пока фронт ещё не утверждён.
# Пусто по умолчанию = обычный вход. НИКОГДА не задавайте это в проде/стейджинге —
# значения уйдут в публичный браузерный бандл.
# NEXT_PUBLIC_LABEL_DEV_EMAIL=
# NEXT_PUBLIC_LABEL_DEV_PASSWORD=

# ВРЕМЕННО, только для локальной разработки кабинета артиста (components/auth/AuthGate.tsx):
# аналогично: задать оба — автовход, пусто — обычная форма входа.
# NEXT_PUBLIC_ARTIST_DEV_EMAIL=
# NEXT_PUBLIC_ARTIST_DEV_PASSWORD=
